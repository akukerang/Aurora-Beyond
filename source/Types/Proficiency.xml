ption><sheet action="" usage="" display="true"></sheet><rules></rules><setters></setters></element><element name="Weapon Proficiency (Musket)" type="Proficiency" id="ID_WOTC_DMG_PROFICIENCY_WEAPON_RENAISSANCE_FIREARMS_MUSKET"><description usage="" level="0"></description><sheet action="" usage="" display="true"></sheet><rules></rules><setters></setters></element><element name="Weapon Proficiency (Pistol)" type="Proficiency" id="ID_WOTC_DMG_PROFICIENCY_WEAPON_RENAISSANCE_FIREARMS_PISTOL"><description usage="" level="0"></description><sheet action="" usage="" display="true"></sheet><rules></rules><setters></setters></element><element name="Weapon Proficiency (Hoopak)" type="Proficiency" id="ID_WOTC_DSDQ_PROFICIENCY_WEAPON_PROFICIENCY_HOOPAK"><description usage="" level="0"></description><sheet action="" usage="" display="false"></sheet><rules></rules><setters></setters></element><element name="Tool Proficiency (Vehicles (Air and Sea))" type="Proficiency" id="ID_WOTC_ERLW_PROFICIENCY_TOOL_PROFICIENCY_VEHICLES_AIR_SEA"><description usage="" level="0"></description><sheet action="" usage="" display="true"></sheet><rules></rules><setters></setters></element><element name="Weapon Proficiency (Double-Bladed Scimitar)" type="Proficiency" id="ID_WOTC_ERLW_WEAPON_PROFICIENCY_DOUBLE_BLADED_SCIMITAR"><description usage="" level="0"></description><sheet action="" usage="" display="false"></sheet><rules></rules><setters></setters></element><element name="Tool Proficiency (Whistle-Stick)" type="Proficiency" id="ID_WOTC_OGA_PROFICIENCY_TOOL_PROFICIENCY_WHISTLE_STICK"><description usage="" level="0">
			<p>This is a hollow tube with holes cut throughout, much like a flute. You can play music with it for entertainment, but the grung also swing it about by a sturdy cord (attached) to create a sound recognizable by other grung, so they know each other’s approximate location.</p>
			<p class="indent">Additionally, grung that know Thieves’ Cant can use a whistle stick in this manner to communicate over distance.</p>
